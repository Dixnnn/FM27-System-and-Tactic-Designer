# downloaded files differ.
BEPINEX_CORE_SHA256=dd8dd33cab8b383af4066a2d0abdc3f290e7dcfa50bc322602b607135efbec78
WINHTTP_SHA256=8c6cdbc38836dee87e3368f5de1994d7c0ccebf29e4ce7aba3c0981f9375412c
