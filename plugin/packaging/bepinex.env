# BepInEx build for the full package (taken over from FM View Exporter's packaging/bepinex.env).
# #755 is the first build that reads Unity 6000.3's IL2CPP metadata v39 (FM27); tested with FM27 on 2026-10-29.
BEPINEX_BUILD=755
